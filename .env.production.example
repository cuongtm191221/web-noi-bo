# =============================================================
#  Production environment template
#  Copy this file to `.env.production` and fill in values.
#  `docker-compose.prod.yml` reads these vars.
#  NEVER commit `.env.production` to git.
# =============================================================

# ------- Public domain -------
# The domain your app will be served on (HTTPS)
DOMAIN=docs.example.com

# ------- Postgres (internal Docker network) -------
POSTGRES_USER=rikkei
# Run: openssl rand -base64 24
POSTGRES_PASSWORD=replace_me_with_strong_random_password
POSTGRES_DB=rikkei_docs
POSTGRES_PORT=5432

# ------- NextAuth / Session -------
# Run: openssl rand -base64 32
AUTH_SECRET=replace_me_with_32_char_random_string
# Must match DOMAIN (HTTPS)
NEXTAUTH_URL=https://docs.example.com

# ------- Admin user (seeded on first DB init) -------
# Used by: scripts/seed.ts via the web service command
ADMIN_EMAIL=admin@yourdomain.com
# Min 12 chars, mix letters+numbers
ADMIN_PASSWORD=replace_me_with_strong_password_min_12_chars
ADMIN_NAME=Admin Rikkei

# ------- MCP server (optional, only if profile "mcp" enabled) -------
# Run: openssl rand -base64 32
MCP_API_KEY=replace_me_with_32_char_random_string

# ------- AI Pipeline (optional, only if profile "ai" enabled) -------
# Ollama model (default: qwen2.5:7b)
OLLAMA_MODEL=qwen2.5:7b
# Internal Docker host (don't change unless Ollama is on different host)
OLLAMA_HOST=http://ollama:11434
# CORS whitelist — comma-separated
ALLOWED_ORIGINS=https://docs.example.com

# ------- Server config -------
NODE_ENV=production
WEB_PORT=3000
AI_PIPELINE_PORT=8000
OLLAMA_PORT=11434
MCP_PORT=8765